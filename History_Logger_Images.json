    {
      "parameters": {
        "jsCode": "// n8n Code Node\n\nconst input = $input.first().json;\n\n// 1. Build actuator_decisions (type → classification)\nconst actuatorDecisions = {};\nfor (const a of input.actuators || []) {\n  actuatorDecisions[a.type] = a.classification;\n}\n\n// 2. Build final output\nconst output = {\n  timestamp: input.meta?.triggered_at,\n\n  summary: input.image_processing?.summary,\n\n  confidence: input.image_processing?.confidence,\n\n  features: {\n    rain_detected: input.image_processing?.features?.rain_detected,\n    water_on_leaves: input.image_processing?.features?.water_on_leaves,\n    cloud_cover: input.image_processing?.features?.cloud_cover,\n    lighting_level: input.image_processing?.features?.lighting_level,\n    shadows_present: input.image_processing?.features?.shadows_present,\n    plant_motion_detected: input.image_processing?.features?.plant_motion_detected,\n    motion_intensity: input.image_processing?.features?.motion_intensity\n  },\n\n  actuator_decisions: actuatorDecisions\n};\n\nreturn [{ json: output }];"
      },
