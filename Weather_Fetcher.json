    {
      "parameters": {
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.location.latitude }}&longitude={{ $json.location.longitude }}&hourly=temperature_2m,relative_humidity_2m,precipitation_probability&forecast_days=2&timezone={{ $json.location.timezone }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
