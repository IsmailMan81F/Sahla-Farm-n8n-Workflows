        80
      ],
      "id": "0d63c8b0-5514-4613-9507-507d0e53d244",
      "name": "Weather_API_Call"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following raw hourly weather data for the Algiers site over the next 48 hours:\n\nTIMESTAMPS:\n{{ JSON.stringify($json.hourly.time) }}\n\nTEMPERATURES (°C):\n{{ JSON.stringify($json.hourly.temperature_2m) }}\n\nPRECIPITATION PROBABILITY (%):\n{{ JSON.stringify($json.hourly.precipitation_probability) }}\n\nBased on this data, return a JSON object with:\n- \"summary\": a 2-4 sentence weather narrative covering atmospheric transitions, rain risks, and heat peaks\n- \"state\": the dominant weather condition, must be one of: \"sunny\", \"cloudy\", \"rainy\", \"snowy\", \"stormy\", \"foggy\"\n- \"precipitation_probability\": a single number (0-100) representing the overall precipitation risk for the next 48 hours\n\nReturn only the JSON object, nothing else.",
        "options": {
          "systemMessage": "You are a Meteorological Strategist specialized in agricultural weather analysis. You receive raw hourly weather data for a specific site and your job is to interpret it and return a structured JSON response.\n\n─── OUTPUT FORMAT ───────────────────────────────────────────────────\n\nYou must return ONLY a valid JSON object with exactly these three fields:\n\n{\n  \"summary\": \"...\",\n  \"state\": \"...\",\n  \"precipitation_probability\": ...\n}\n\nField rules:\n- \"summary\": a concise but insightful weather narrative for the next 48 hours, highlighting significant atmospheric transitions, immediate rain risks, and intensity of daily heat peaks. 2-4 sentences maximum.\n- \"state\": a single word representing the dominant weather condition. Must be one of: \"sunny\", \"cloudy\", \"rainy\", \"snowy\", \"stormy\", \"foggy\"\n- \"precipitation_probability\": a single number (0-100) representing the overall precipitation probability for the next 48 hours, derived from the hourly data (use the peak or average, whichever is more representative for agricultural decisions)\n\n─── STRICT OUTPUT RULES ─────────────────────────────────────────────\n\n- Return ONLY the JSON object, nothing else\n- No explanation, no commentary, no markdown, no code blocks\n- Do not add any extra fields\n- \"state\" must be exactly one of the six allowed values, lowercase"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        720,
        80
      ],
      "id": "2bad808a-149a-4ab1-ab14-71723d9efddb",
      "name": "Weather_Agent"
    },
    {
      "parameters": {
        "jsCode": "const mainJson = { ...( $('History_Loader').first().json ) };\nconst raw = $('Weather_Agent').first().json.output;\nconst weather = JSON.parse(raw);\nconst weatherRaw = $('Weather_API_Call').first().json;\n\nmainJson.weather.summary = weather.summary;\nmainJson.weather.state = weather.state;\nmainJson.weather.precipitation_probability = weather.precipitation_probability;\n\n// ─── Build weather insights ───────────────────────────────────────────────────\nconst times    = weatherRaw.hourly.time;\nconst temps    = weatherRaw.hourly.temperature_2m;\nconst humidity = weatherRaw.hourly.relative_humidity_2m;\nconst precip   = weatherRaw.hourly.precipitation_probability;\n\n// Find max and min temperature\nlet maxTemp = { value: -Infinity, time: null };\nlet minTemp = { value:  Infinity, time: null };\ntemps.forEach((t, i) => {\n  if (t > maxTemp.value) maxTemp = { value: t, time: times[i] };\n  if (t < minTemp.value) minTemp = { value: t, time: times[i] };\n});\n\n// Keep only every 3 hours to reduce size (48h → 16 entries)\nconst hourly = times\n  .map((t, i) => ({\n    time:                      t,\n    temperature:               temps[i],\n    humidity:                  humidity[i],\n    precipitation_probability: precip[i]\n  }))\n  .filter((_, i) => i % 3 === 0);\n\nmainJson.weather.insights = {\n  highlights: {\n    max_temperature: maxTemp,\n    min_temperature: minTemp\n  },\n  hourly\n};\n\nreturn [{ json: mainJson }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        80
      ],
      "id": "63a04c6e-5103-48c4-b55a-191f72c79cec",
      "name": "Weather_Enriched"
    }
  ],
