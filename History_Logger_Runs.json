      "name": "Notifications_Manager"
    },
    {
      "parameters": {
        "jsCode": "// n8n Code Node\n\nconst input = $input.first().json;\n\n// 1. Sensors → object\nconst sensorsObj = {};\nfor (const s of input.sensors || []) {\n  sensorsObj[s.type] = s.value;\n}\n\n// 2. Actuators → keep ALL (even if not running)\nconst actuatorsArr = (input.actuators || []).map(a => ({\n  type: a.type,\n  classification: a.classification,\n  execute_at: a.run?.execute_at || null,\n  execute_until: a.run?.execute_until || null,\n  duration_minutes: a.run?.duration_minutes || null\n}));\n\n// 3. Only active warnings\nconst warningsArr = (input.warnings || [])\n  .filter(w => w.active)\n  .map(w => ({\n    name: w.name,\n    severity: w.severity\n  }));\n\n// 4. Final output\nconst output = {\n  run_id: input.meta?.run_id,\n  triggered_at: input.meta?.triggered_at,\n\n  crop: {\n    type: input.crop?.type,\n    growth_stage: input.crop?.growth_stage,\n    mode: input.crop?.mode\n  },\n\n  sensors: sensorsObj,\n\n  actuators: actuatorsArr,\n\n  warnings: warningsArr,\n\n  weather: {\n    state: input.weather?.state,\n    precipitation_probability: input.weather?.precipitation_probability,\n    summary: input.weather?.summary\n  },\n\n  recommendation: input.recommendation\n};\n\nreturn [{ json: output }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
